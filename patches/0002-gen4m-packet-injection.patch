index bf9734d..5540b17 100644
--- a/connectivity/wlan/core/gen4m/Kbuild.6878
+++ b/connectivity/wlan/core/gen4m/Kbuild.6878
@@ -20,6 +20,14 @@ MODULE_NAME := wlan_drv_gen4m_6878
 CONFIG_SNIFFER_RADIOTAP := y
 ccflags-y += -DCFG_SUPPORT_SNIFFER_RADIOTAP
 ccflags-y += -DCFG_SUPPORT_PDMA_SCATTER
+# --- Malachite: packet injection ---------------------------------------------
+# Injected 802.11 frames are transmitted through the firmware's 802.11 data path
+# (the management-frame mechanism). nic_tx.c only sets MSDU_INFO.fgIs802_11 for
+# ENUM_PKT_802_11_MGMT skbs when CFG_SUPPORT_TX_MGMT_USE_DATAQ is on, so enable
+# it. NOTE: this routes ALL management frames through the data queue, a
+# behavioural change for normal operation — do NOT include this in the passive
+# first-test build; validate stability on a tester device before shipping.
+ccflags-y += -DCFG_SUPPORT_TX_MGMT_USE_DATAQ=1
 # -----------------------------------------------------------------------------
 
 include $(KO_CODE_PATH)/Kbuild.main
